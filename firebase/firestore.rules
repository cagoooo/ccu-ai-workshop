rules_version = '2';
// akai-slide-interact：阿凱老師互動簡報共用專案
// 集合一律以「簡報slug_」為前綴；學員只能「新增」；只有管理員能清除聊天室
service cloud.firestore {
  match /databases/{database}/documents {
    // 文字雲：<slug>_wordcloud 或 <slug>_wordcloud_<題號>
    match /{col}/{docId} {
      allow read: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_(wordcloud|poll)(_[a-z0-9]+)?$')
        || col.matches('^[a-z0-9]+(_[a-z0-9]+)*_(chat|react|live)$');

      // 聊天室：<slug>_chat，一則訊息一份文件；只能新增，不能修改或刪除
      allow create: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_chat$')
        && request.resource.data.keys().hasOnly(['name', 'text', 'kind', 'uid', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 200
        && request.resource.data.uid is string
        && request.resource.data.uid.size() <= 40
        && (request.resource.data.kind == 'msg'
          || (request.resource.data.kind == 'react'
            && request.resource.data.text in ['👍', '❤️', '👏', '😮', '🤔', '❓']))
        && request.resource.data.created_at == request.time;

      allow create: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_wordcloud(_[a-z0-9]+)?$')
        && request.resource.data.keys().hasOnly(['word', 'created_at'])
        && request.resource.data.word is string
        && request.resource.data.word.size() >= 1
        && request.resource.data.word.size() <= 20
        && request.resource.data.created_at == request.time;

      // 投票：每位投票者一份文件（doc id = 投票者代號），可改票
      allow create, update: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_poll(_[a-z0-9]+)?$')
        && docId.size() <= 40
        && request.resource.data.keys().hasOnly(['opt', 'updated_at'])
        && request.resource.data.opt in ['a', 'b', 'c', 'd', 'e', 'f']
        && request.resource.data.updated_at == request.time;

      // 表情回饋：<slug>_react，獨立集合只給講台監聽（學員手機不用下載每個表情，省讀取額度）
      allow create: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_react$')
        && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 12
        && request.resource.data.uid is string
        && request.resource.data.uid.size() <= 40
        && request.resource.data.text in ['👍', '❤️', '👏', '😮', '🤔', '❓']
        && request.resource.data.created_at == request.time;

      // 簡報進度：<slug>_live/state，只有管理員（講台）能寫入目前頁碼，學員端唯讀
      allow create, update: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_live$')
        && docId == 'state'
        && request.auth != null
        && request.auth.token.email == 'ccu-admin@akai-slide-interact.firebaseapp.com'
        && request.auth.uid == 'RgeBnXayNWPt0QWpaZWTZf6O90T2'
        && request.resource.data.keys().hasOnly(['h', 'on', 'updated_at'])
        && (!('on' in request.resource.data) || request.resource.data.on is bool)
        && request.resource.data.h is int
        && request.resource.data.h >= 0
        && request.resource.data.h < 500
        && request.resource.data.updated_at == request.time;

      // 只有管理員帳號（Firebase 登入，密碼存在 Firebase，不在程式碼裡）可以清除聊天室
      allow delete: if col.matches('^[a-z0-9]+(_[a-z0-9]+)*_(chat|react)$')
        && request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'ccu-admin@akai-slide-interact.firebaseapp.com'
        && request.auth.uid == 'RgeBnXayNWPt0QWpaZWTZf6O90T2';
    }
  }
}
